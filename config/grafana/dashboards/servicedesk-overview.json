            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "reduceOptions": {
                    "calcs": [
                        "lastNotNull"
                    ],
                    "fields": "",
                    "values": false
                }
            },
            "title": "API Availability (15m)",
            "type": "stat",
            "targets": [
                {
                    "expr": "avg_over_time(up{job=\"servicedesk_api\"}[15m]) * 100",
                    "legendFormat": "Availability %",
                    "refId": "A"
                }
            ]
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 4
            },
            "id": 4,
            "title": "HTTP Requests / sec (Throughput)",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "sum by (endpoint) (rate(servicedesk_http_requests_total[1m]))",
                    "legendFormat": "{{endpoint}}",
                    "refId": "A"
                }
            ]
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0,
                    "color": {
                        "mode": "palette-classic"
                    }
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 4
            },
            "id": 5,
            "title": "HTTP Errors (4xx & 5xx req/s)",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "sum by (status, endpoint) (rate(servicedesk_http_requests_total{status=~\"4..|5..\"}[1m]))",
                    "legendFormat": "HTTP {{status}} ({{endpoint}})",
                    "refId": "A"
                }
            ]
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 4
            },
            "id": 6,
            "title": "API Latency (p50 / p95 / p99)",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum by (le) (rate(servicedesk_http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p50",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(servicedesk_http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p95",
                    "refId": "B"
                },
                {
                    "expr": "histogram_quantile(0.99, sum by (le) (rate(servicedesk_http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p99",
                    "refId": "C"
                }
            ]
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 0,
                "y": 12
            },
            "id": 7,
            "title": "Host CPU Utilization (%)",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
                    "legendFormat": "CPU Used %",
                    "refId": "A"
                }
            ]
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "min": 0,
                    "max": 100
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 8,
                "y": 12
            },
            "id": 8,
            "title": "Host RAM & Root Disk Usage (%)",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
                    "legendFormat": "RAM Used %",
                    "refId": "A"
                },
                {
                    "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"})) * 100",
                    "legendFormat": "Disk / Used %",
                    "refId": "B"
                }
            ]
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "Bps",
                    "min": 0
                },
                "overrides": []
            },
            "gridPos": {
                "h": 8,
                "w": 8,
                "x": 16,
                "y": 12
            },
            "id": 9,
            "title": "Network Traffic (RX / TX Bytes/s)",
            "type": "timeseries",
            "targets": [
                {
                    "expr": "sum(rate(node_network_receive_bytes_total{device!=\"lo\"}[1m]))",
                    "legendFormat": "Inbound (RX)",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(node_network_transmit_bytes_total{device!=\"lo\"}[1m]))",
                    "legendFormat": "Outbound (TX)",
                    "refId": "B"
                }
            ]
        }
    ],
